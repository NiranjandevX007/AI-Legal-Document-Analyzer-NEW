<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LegalLens AI - Document Analyzer</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="background-orb orb-1"></div>
    <div class="background-orb orb-2"></div>
    
    <!-- INITIAL UPLOAD / LOADING VIEW -->
    <div class="container" id="initial-view">
        <header>
            <div class="logo">
                <div class="icon-container">
                    <i class="fa-solid fa-scale-balanced"></i>
                </div>
                <h1>LegalLens <span>AI</span></h1>
            </div>
            <p class="subtitle">AI-Powered Contract Analysis & Simplification</p>
        </header>

        <main>
            <!-- Upload Panel -->
            <div class="upload-section glass-panel" id="upload-panel">
                <div class="upload-area" id="drop-zone">
                    <div class="upload-icon-container">
                        <i class="fa-solid fa-cloud-arrow-up upload-icon"></i>
                    </div>
                    <h2>Upload Legal Document</h2>
                    <p>Drag & drop your PDF file here, or click to browse</p>
                    <input type="file" id="file-input" accept="application/pdf" hidden>
                    <button class="btn primary-btn" onclick="document.getElementById('file-input').click()">Select PDF</button>
                </div>
                <div class="file-info hidden" id="file-info">
                    <i class="fa-solid fa-file-pdf file-icon"></i>
                    <span id="file-name">document.pdf</span>
                    <button class="btn icon-btn" id="remove-file" title="Remove"><i class="fa-solid fa-times"></i></button>
                </div>
                <button class="btn analyze-btn hidden" id="analyze-btn">
                    Analyze Document <i class="fa-solid fa-wand-magic-sparkles"></i>
                </button>
            </div>

            <!-- Loading Panel -->
            <div class="loading-section glass-panel hidden" id="loading-panel">
                <div class="spinner-container">
                    <div class="spinner"></div>
                </div>
                <h3>Analyzing Document...</h3>
                <p>Running Flan-T5 Large Transformer Model</p>
                <div class="progress-bar">
                    <div class="progress-fill"></div>
                </div>
                <p class="loading-tip">Deciphering legal clauses...</p>
            </div>
        </main>
    </div>

    <!-- FULL PAGE APP VIEW (Shown after analysis) -->
    <div class="app-container hidden" id="app-view">
        
        <!-- Top Navigation Bar -->
        <nav class="app-nav glass-panel">
            <div class="app-brand">
                <i class="fa-solid fa-scale-balanced"></i> LegalLens
            </div>
            
            <div class="nav-buttons">
                <button class="nav-btn active" data-page="page-summary">
                    <i class="fa-solid fa-book-open-reader"></i> Summary
                </button>
                <button class="nav-btn" data-page="page-complex">
                    <i class="fa-solid fa-book-journal-whills"></i> Complex Terms
                </button>
                <button class="nav-btn" data-page="page-risks">
                    <i class="fa-solid fa-triangle-exclamation"></i> Risks
                </button>
                <button class="nav-btn" data-page="page-obligations">
                    <i class="fa-solid fa-clipboard-check"></i> Obligations
                </button>
                <button class="nav-btn" data-page="page-financial">
                    <i class="fa-solid fa-sack-dollar"></i> Financials
                </button>
                <button class="nav-btn" data-page="page-clauses">
                    <i class="fa-solid fa-file-contract"></i> Clauses
                </button>
                <button class="nav-btn" data-page="page-distribution">
                    <i class="fa-solid fa-chart-pie"></i> Insights
                </button>
            </div>

            <button class="btn secondary-btn" id="new-analysis-btn">
                <i class="fa-solid fa-rotate-right"></i> New
            </button>
        </nav>

        <!-- Main Content Area -->
        <main class="app-content">
            <!-- Global Metadata Banner -->
            <div class="metadata-banner glass-panel" id="metadata-banner">
                <i class="fa-solid fa-circle-check metadata-icon"></i>
                <span id="metadata-text">Document processed successfully.</span>
            </div>

            <!-- Full Page Sections -->
            <section class="page-section active glass-panel" id="page-summary">
                <h2 class="page-title">Elaborate Summary (Plain English)</h2>
                <div class="content-body">
                    <p class="summary-text" id="summary-text"></p>
                </div>
            </section>
            
            <section class="page-section hidden glass-panel" id="page-complex">
                <h2 class="page-title">Complex Terms Explained</h2>
                <div class="content-body">
                    <ul id="complex-list" class="entity-list complex-style"></ul>
                </div>
            </section>
            
            <section class="page-section hidden glass-panel" id="page-risks">
                <h2 class="page-title">Identified Risks</h2>
                
                <div class="risk-filters" style="margin-bottom: 1.5rem; display: flex; gap: 0.5rem; justify-content: flex-start;">
                    <button class="btn secondary-btn risk-filter-btn active" data-filter="all">All</button>
                    <button class="btn secondary-btn risk-filter-btn" data-filter="high" style="border-color: #e07a5f; color: #e07a5f;">High</button>
                    <button class="btn secondary-btn risk-filter-btn" data-filter="medium" style="border-color: #f2cc8f; color: #f2cc8f;">Medium</button>
                    <button class="btn secondary-btn risk-filter-btn" data-filter="low" style="border-color: #81b29a; color: #81b29a;">Low</button>
                </div>
                
                <div class="content-body">
                    <ul id="risks-list" class="entity-list risks-style"></ul>
                </div>
            </section>
            
          <section class="page-section active glass-panel" id="page-summary">
    <h2 class="page-title">Elaborate Summary (Plain English)</h2>
    <div class="content-body">
        <p class="summary-text" id="summary-text"></p>

        <br><br>

        <button id="translate-kn-btn" class="btn secondary-btn">
            🌐 Translate to Kannada
        </button>

    </div>
</section>
            
            <section class="page-section hidden glass-panel" id="page-financial">
                <h2 class="page-title">Financial Terms</h2>
                <div class="content-body">
                    <ul id="financial-list" class="entity-list financial-style"></ul>
                </div>
            </section>
            
            <section class="page-section hidden glass-panel" id="page-clauses">
                <h2 class="page-title">Categorized Clauses</h2>
                <div class="content-body">
                    <ul id="clauses-list" class="entity-list clauses-style"></ul>
                </div>
            </section>
            
            <section class="page-section hidden glass-panel chart-section" id="page-distribution">
                <h2 class="page-title">AI Analytical Insights</h2>
                <div class="content-body chart-wrapper">
                    <img id="distribution-chart" src="" alt="Distribution Chart">
                    <img id="severity-chart" src="" alt="Severity Chart">
                </div>
            </section>

        </main>
    </div>
    
    <script src="/static/script.js"></script>
</body>
</html>
